{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "psicologiadireta",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
